## AI Scenario Simulator - Environment Configuration Template
## Copy this file to .env.local and fill in your actual API keys. Do NOT commit .env.local.

# --- Primary Provider (choose one) ---
# Azure OpenAI (recommended for enterprise usage)
AZURE_OPENAI_API_KEY=your_azure_openai_key
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=your-deployment-name
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# OR: Direct OpenAI
OPENAI_API_KEY=sk-your_openai_api_key_here

# --- Optional Additional Providers ---
# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
# Zhipu (智谱 GLM)
ZHIPU_API_KEY=your_zhipu_api_key_here

# --- Concurrency / Performance ---
# Maximum concurrent Azure requests (default 3 if unset)
AZURE_MAX_CONCURRENCY=3

# --- Mock Mode (local only) ---
# When enabled (1/true), all model calls return deterministic fake data without hitting external APIs.
MOCK_MODE=0

# --- Environment (usually set automatically) ---
# NODE_ENV=development

# Notes:
# 1. Provide at least one provider key (Azure preferred). Others are optional.
# 2. Leave unused provider keys blank; the app will skip those adapters.
# 3. Do not include NEXTAUTH_* variables (auth not used currently).
